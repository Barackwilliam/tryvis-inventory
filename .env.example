# ---- Django ----
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=inventory.tryvis.co.tz,tryvis-inventory.onrender.com
CSRF_TRUSTED_ORIGINS=https://inventory.tryvis.co.tz,https://tryvis-inventory.onrender.com
TIME_ZONE=Africa/Dar_es_Salaam

# ---- Supabase Postgres ----
# SAME instance as the tryvis.co.tz website. Different schema.
# Use the SESSION pooler (port 5432), not the transaction pooler (6543):
# the stock ledger holds row locks inside transactions, and the schema
# search_path is reliable on a session connection.
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=your-db-password
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
# This project lives ONLY in this schema. Run `python manage.py init_schema`
# once before the first migrate, then `python manage.py db_status` to confirm.
DB_SCHEMA=inventory
DB_CONN_MAX_AGE=0

# ---- Email for low-stock alerts ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=inventory@tryvis.co.tz
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Tryvis Inventory <inventory@tryvis.co.tz>

# ---- Written briefing (optional) ----
# Leave blank and the system writes the briefing itself, free and offline.
# With a key, xAI phrases the same figures. New accounts get promotional
# credits; Grok 4.1 Fast is about USD 0.20 per million input tokens, and the
# briefing is cached against the figures, so it costs cents a month.
# Get a key at https://console.x.ai — check https://docs.x.ai/docs/models
# for the current model id before changing XAI_MODEL.
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast

# ---- Help material for the JamiiBot assistant ----
# Published at https://<your-domain>/help/knowledge.txt — paste that link into
# JamiiBot as the training source. Leave the token blank for an open link, or
# set one to require /help/knowledge.txt?k=<token>.
HELP_DOC_TOKEN=

# ---- Company details on printed documents ----
COMPANY_NAME=Tryvis Investments Limited
COMPANY_TAGLINE=Industrial Engineering & Supply
COMPANY_ADDRESS=Dar es Salaam, Tanzania
COMPANY_WEBSITE=www.tryvis.co.tz
COMPANY_PHONE=
COMPANY_TIN=
ITEM_CODE_COMPANY_PREFIX=TIL
VAT_RATE_PERCENT=18
